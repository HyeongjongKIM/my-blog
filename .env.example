# Local Keystatic GitHub authentication only; not needed by Cloudflare Pages.
# On first setup, run pnpm dev:github and follow /keystatic > Log in with GitHub.
# Keystatic generates these values in .env. Keep actual values uncommitted.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# At least 32 characters; the setup wizard generates this for you.
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
