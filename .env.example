# Keystatic GitHub authentication for local/admin Worker; not needed by Pages.
# On first setup, run pnpm dev:github and follow /keystatic > Log in with GitHub.
# Keystatic generates these values in .env. Keep actual values uncommitted.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# At least 32 characters; the setup wizard generates this for you.
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Server-side image optimizer; restart the administrator after changing these.
IMAGE_OPTIMIZER_API_URL=http://localhost:8787
# Optional: match the Worker's API_KEY. Never use a NEXT_PUBLIC_ variable.
IMAGE_OPTIMIZER_API_KEY=
