{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_KEYSTATIC_STORAGE=local next dev",
    "dev:github": "NEXT_PUBLIC_KEYSTATIC_STORAGE=github next dev",
    "build": "next build && node scripts/clean-static-export.mjs",
    "build:static": "pnpm build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "test": "vitest run --passWithNoTests",
    "build:admin:next": "KEYSTATIC_ADMIN_WORKER=1 NEXT_PUBLIC_KEYSTATIC_STORAGE=github next build",
    "build:admin": "KEYSTATIC_ADMIN_WORKER=1 NEXT_PUBLIC_KEYSTATIC_STORAGE=github opennextjs-cloudflare build",
    "preview:admin": "pnpm build:admin && opennextjs-cloudflare preview",
    "deploy:admin": "pnpm build:admin && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@markdoc/markdoc": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@10.33.4"
}
